FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    ( -5.0 -5.0 -5.0)
    ( 15.0 -5.0 -5.0)
    ( 15.0  5.0 -5.0)
    ( -5.0  5.0 -5.0)
    ( -5.0 -5.0 5.0)
    ( 15.0 -5.0 5.0)
    ( 15.0  5.0 5.0)
    ( -5.0  5.0 5.0)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (80 40 40) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)		//x = -5
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (2 6 5 1)		//x = 15
        );
    }

    topAndBottom
    {
        type patch;
        faces
        (
            (3 7 6 2)		//y = 5
            (1 5 4 0)		//y = -5
            (0 3 2 1)		//z = -5
            (4 5 6 7)		//z = 5
        );
    }
);

